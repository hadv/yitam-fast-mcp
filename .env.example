# --- Transport ---
# stdio | http | sse
# "http" is Streamable HTTP (the modern MCP transport, endpoint /mcp).
# "sse" is deprecated in the MCP spec and kept only for legacy clients.
TRANSPORT=http
HOST=0.0.0.0
PORT=3000

# Shared bearer token for HTTP/SSE transports.
# Leave empty to disable auth (local development only).
MCP_AUTH_TOKEN=

# --- Qdrant ---
COLLECTION_NAME=your_collection_name
QDRANT_URL=https://your-qdrant-instance-url.example.com:6333
QDRANT_API_KEY=your_qdrant_api_key

# --- Gemini embeddings ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-embedding-001
# Optional: reduce embedding dimensions for compatibility with existing collections.
# Default is 3072 for gemini-embedding-001. Set to 768 if your collection expects that size.
# GEMINI_EMBEDDING_DIMENSIONS=768

# --- Search defaults ---
DEFAULT_LIMIT=10
MIN_SCORE_THRESHOLD=0.7
MAX_RESULTS=20

LOG_LEVEL=INFO
